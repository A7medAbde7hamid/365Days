# Production environment variables template.
# Copy to .env.production and fill in, OR set these in Vercel dashboard:
#   Vercel → Project → Settings → Environment Variables
#
# These are PUBLIC values (safe for client bundle via Vite's VITE_ prefix).
# The anon key is protected by Row Level Security — never add the service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
